      "blocks": [
        {
          "type": "paragraph",
          "text": "Functions are reusable blocks of code."
        },
        {
          "type": "codeBox",
          "lang": "🟨 JavaScript",
          "label": "function.js",
          "lines": [
            "function greet(name) {",
            "   return 'Hello ' + name;",
            "}",
            "",
            "console.log(greet('Ashish'));"
          ]
        }
      ]
    },

    {
