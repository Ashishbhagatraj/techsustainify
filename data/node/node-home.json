      "sectionId": "http-server",
      "title": "Create Simple HTTP Server",
      "blocks": [
        {
          "type": "codeBox",
          "lang": "🟢 Node.js",
          "label": "server.js",
          "lines": [
            "const http = require('http');",
            "",
            "const server = http.createServer((req, res) => {",
            "  res.write('Welcome to Node.js Server');",
            "  res.end();",
            "});",
            "",
            "server.listen(3000);"
          ]
        }
      ]
    },

    {
      "sectionId": "expressjs",
      "title": "What is Express.js?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>Express.js</strong> is the most popular web framework for Node.js. It simplifies routing, APIs, middleware handling, and backend application development."
        },
        {
          "type": "codeBox",
          "lang": "🟢 Express.js",
          "label": "server.js",
          "lines": [
            "const express = require('express');",
            "const app = express();",
            "",
            "app.get('/', (req, res) => {",
            "  res.send('Hello Express.js');",
            "});",
            "",
            "app.listen(3000);"
          ]
        }
      ]
    },

