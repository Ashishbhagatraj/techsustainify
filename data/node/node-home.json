  "sections": [

    {
      "sectionId": "what-is-nodejs",
      "title": "What is Node.js?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>Node.js</strong> is an open-source, cross-platform JavaScript runtime environment that allows developers to run JavaScript outside the browser. It is built on Google's powerful <strong>V8 JavaScript Engine</strong> used in Chrome."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Node.js enables developers to build fast and scalable backend applications using JavaScript. Before Node.js, JavaScript was mainly limited to browsers, but Node.js made JavaScript a full-stack language."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Today, Node.js powers APIs, real-time applications, chat systems, streaming platforms, and enterprise backend systems used by companies like Netflix, PayPal, LinkedIn, Uber, and Walmart."
        }
      ]
    },

    {
      "sectionId": "history-nodejs",
      "title": "History of Node.js",
      "blocks": [
        {
          "type": "bulletList",
          "items": [
            { "strong": "2009", "text": " — Node.js created by Ryan Dahl." },
            { "strong": "2010", "text": " — npm package manager introduced." },
            { "strong": "2011", "text": " — Node.js gained massive popularity among backend developers." },
            { "strong": "2015", "text": " — Node.js Foundation established." },
            { "strong": "2019", "text": " — Node.js merged with JS Foundation to form OpenJS Foundation." },
            { "strong": "2024-2026", "text": " — Node.js became one of the most dominant backend runtimes for APIs and microservices." }
          ]
        }
      ]
    },

