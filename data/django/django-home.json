      "sectionId": "interview-questions",
      "title": "Django Interview Questions",
      "blocks": [
        {
          "type": "interviewQA",
          "items": [
            {
              "q": "Q1. What is Django?",
              "a": "Django is a high-level Python web framework used to build secure and scalable web applications quickly.",
              "tag": "Must Know"
            },
            {
              "q": "Q2. What is MVT architecture in Django?",
              "a": "MVT stands for Model, View, and Template. It separates database logic, business logic, and presentation layer.",
              "tag": "Frequently Asked"
            },
            {
              "q": "Q3. What is Django ORM?",
              "a": "Django ORM allows developers to interact with databases using Python classes instead of SQL queries.",
              "tag": "Must Know"
            },
            {
              "q": "Q4. What is manage.py?",
              "a": "manage.py is a command-line utility used to manage Django projects.",
