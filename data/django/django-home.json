  "sections": [
    {
      "sectionId": "what-is-django",
      "title": "What is Django?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>Django is a high-level Python web framework</strong> used for building secure, scalable, and maintainable web applications quickly. It was created to help developers build web applications faster with less code."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Django follows the principle of <strong>\"Don't Repeat Yourself (DRY)\"</strong>. It provides built-in features like authentication, database ORM, routing, forms, security protection, and an admin panel — reducing the need to write repetitive code."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Django is built on Python, which means developers can use the full power of Python libraries along with Django's web development tools. It is widely used for backend development, APIs, dashboards, CMS systems, and enterprise-level applications."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Popular companies and platforms like <strong>Instagram</strong>, <strong>Pinterest</strong>, <strong>Mozilla</strong>, <strong>Disqus</strong>, and <strong>NASA</strong> have used Django in their tech stacks."
        }
      ]
    },

    {
      "sectionId": "history-django",
      "title": "History of Django Framework",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Django was created in <strong>2003</strong> by <strong>Adrian Holovaty</strong> and <strong>Simon Willison</strong> while working at the Lawrence Journal-World newspaper. They needed a framework that could quickly build news publishing applications."
        },
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "2005",
              "text": " — Django was officially released as an open-source framework."
            },
            {
              "strong": "2008",
              "text": " — Django Software Foundation (DSF) was formed to maintain the framework."
            },
            {
              "strong": "2013",
              "text": " — Django became one of the most popular Python frameworks globally."
            },
            {
              "strong": "2020-2026",
              "text": " — Django introduced async support, performance improvements, better security, and compatibility with modern frontend frameworks."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "features-django",
      "title": "Key Features of Django",
      "blocks": [
        {
          "type": "featureCards",
          "items": [
            {
              "icon": "⚡",
              "title": "Fast Development",
              "text": "Django helps developers build web applications quickly using built-in tools and reusable components."
            },
            {
              "icon": "🔒",
              "title": "Secure",
              "text": "Django protects applications against SQL injection, CSRF, XSS, clickjacking, and other common web vulnerabilities."
            },
            {
              "icon": "🗄️",
              "title": "Powerful ORM",
              "text": "Django ORM allows developers to interact with databases using Python code instead of raw SQL queries."
            },
            {
              "icon": "🛠️",
              "title": "Built-in Admin Panel",
              "text": "Django automatically creates an admin dashboard for managing database records."
            },
            {
              "icon": "📦",
              "title": "Reusable Apps",
              "text": "Django apps are modular and reusable across multiple projects."
            },
            {
              "icon": "🌐",
              "title": "Scalable",
              "text": "Django supports high-traffic and enterprise-level applications."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "mvt-architecture",
      "title": "Django MVT Architecture",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Django follows the MVT (Model-View-Template) architecture pattern."
        },
        {
          "type": "comparisonTable",
          "headers": ["Component", "Purpose"],
          "rows": [
            ["Model", "Handles database and business logic"],
            ["View", "Processes user requests and returns response"],
            ["Template", "Controls frontend presentation layer"]
          ]
        }
      ]
    },

