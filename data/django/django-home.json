  "faq": {
    "sectionId": "faq-heading",
    "title": "Frequently Asked Questions (FAQ)",
    "items": [
      {
        "q": "Is Django easy to learn?",
        "a": "Yes, Django is beginner-friendly if you already know basic Python."
      },
      {
        "q": "Is Django frontend or backend?",
        "a": "Django is primarily a backend web framework."
      },
      {
        "q": "Can Django build APIs?",
        "a": "Yes, Django REST Framework is widely used for API development."
      },
      {
        "q": "Which database does Django support?",
        "a": "Django supports SQLite, PostgreSQL, MySQL, Oracle, and more."
      },
      {
        "q": "Is Django good for large applications?",
        "a": "Yes, Django is highly scalable and used in enterprise-level applications."
      }
