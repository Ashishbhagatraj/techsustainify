    {
      "sectionId": "first-django-project",
      "title": "Create Your First Django Project",
      "blocks": [
        {
          "type": "codeBox",
          "lang": "💻 Terminal",
          "label": "commands",
          "lines": [
            "pip install django",
            "",
            "django-admin startproject myproject",
            "",
            "cd myproject",
            "",
            "python manage.py runserver"
          ]
        },
