  "sections": [
    {
      "sectionId": "what-is-sql",
      "title": "What is SQL?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>SQL (Structured Query Language)</strong> is the standard language used to communicate with relational databases. SQL allows developers to <strong>store</strong>, <strong>retrieve</strong>, <strong>update</strong>, and <strong>delete</strong> data efficiently from database systems like <strong>MySQL</strong>, <strong>PostgreSQL</strong>, <strong>SQLite</strong>, <strong>Oracle</strong>, and <strong>Microsoft SQL Server</strong>."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "SQL is one of the most important technologies in software development because almost every modern application uses databases. Websites, banking systems, e-commerce platforms, hospital management systems, social media apps, and analytics platforms all rely on SQL databases to manage data securely and efficiently."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "SQL is a <strong>declarative language</strong>, meaning you describe <em>what</em> data you want rather than how the database should retrieve it internally. Database engines optimise the query execution automatically using indexes, query planners, and caching systems."
        }
      ]
    },

    {
      "sectionId": "history-of-sql",
      "title": "History of SQL",
      "blocks": [
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "1970",
              "text": " — Edgar F. Codd introduced the relational database model at IBM."
            },
            {
              "strong": "1974",
              "text": " — IBM developed SEQUEL (Structured English Query Language), the foundation of SQL."
            },
            {
              "strong": "1986",
              "text": " — SQL became an ANSI standard."
            },
            {
              "strong": "1987",
              "text": " — ISO officially standardized SQL."
            },
            {
              "strong": "1995-2005",
              "text": " — MySQL, PostgreSQL, Oracle, and SQL Server became dominant database systems."
            },
            {
              "strong": "2026",
              "text": " — SQL remains the global standard for relational database management."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "features-of-sql",
      "title": "Key Features of SQL",
      "blocks": [
        {
          "type": "featureCards",
          "items": [
            {
              "icon": "⚡",
              "title": "Fast Data Retrieval",
              "text": "SQL databases are highly optimized for querying large amounts of data efficiently."
            },
            {
              "icon": "🗄️",
              "title": "Relational Database Support",
              "text": "SQL works with tables, rows, columns, and relationships between datasets."
            },
            {
              "icon": "🔒",
              "title": "Data Security",
              "text": "SQL databases provide authentication, authorization, roles, and permissions."
            },
            {
              "icon": "📈",
              "title": "Scalability",
              "text": "SQL databases can scale from small applications to enterprise systems."
            },
            {
              "icon": "🔗",
              "title": "JOIN Operations",
              "text": "SQL can combine data from multiple tables using JOIN queries."
            },
            {
              "icon": "📦",
              "title": "Transactions (ACID)",
              "text": "SQL databases support reliable transactions with ACID guarantees."
            }
          ]
        }
      ]
    },

