    {
      "sectionId": "joins",
      "title": "SQL JOINs Explained",
      "blocks": [
        {
          "type": "paragraph",
          "text": "JOIN operations combine rows from multiple tables based on related columns."
        },
        {
          "type": "comparisonTable",
          "headers": ["JOIN Type", "Purpose"],
          "rows": [
            [
              "INNER JOIN",
              "Returns matching records from both tables"
            ],
            [
              "LEFT JOIN",
              "Returns all left table rows and matching right rows"
            ],
            [
              "RIGHT JOIN",
              "Returns all right table rows and matching left rows"
            ],
            [
              "FULL JOIN",
              "Returns all matching and non-matching rows"
            ]
          ]
        }
      ]
    },

