  "faq": {
    "sectionId": "faq-heading",
    "title": "Frequently Asked Questions (FAQ)",
    "items": [
      {
        "q": "What does SQL stand for?",
        "a": "SQL stands for Structured Query Language."
      },
      {
        "q": "Is SQL a programming language?",
        "a": "SQL is a database query language used to manage and retrieve data."
      },
      {
        "q": "Which SQL database is best for beginners?",
        "a": "MySQL and SQLite are excellent choices for beginners."
      },
      {
        "q": "Is SQL hard to learn?",
        "a": "No. SQL is considered one of the easiest technical skills to start learning."
      },
      {
        "q": "Can I get a job by learning SQL?",
        "a": "Yes. SQL is required in many software, analytics, and database-related jobs."
      }
