    {
      "sectionId": "swift-optionals",
      "title": "Swift Optionals",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Optionals are one of Swift's most important features. They allow variables to either contain a value or <strong>nil</strong>."
        },
        {
          "type": "codeBox",
          "lang": "🍎 Swift",
          "label": "optionals.swift",
          "lines": [
            "var username: String? = \"Ashish\"",
            "",
            "print(username!)"
          ]
        }
      ]
    },

    {
      "sectionId": "swift-functions",
      "title": "Swift Functions",
      "blocks": [
        {
          "type": "codeBox",
          "lang": "🍎 Swift",
          "label": "functions.swift",
          "lines": [
            "func greet(name: String) {",
            "    print(\"Hello \\(name)\")",
            "}",
            "",
            "greet(name: \"Ashish\")"
          ]
        }
      ]
    },

