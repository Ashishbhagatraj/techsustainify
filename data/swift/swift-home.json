  "sections": [
    {
      "sectionId": "what-is-swift",
      "title": "What is Swift?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>Swift is a powerful, modern, and open-source programming language</strong> developed by Apple for building iOS, macOS, watchOS, and tvOS applications. It was introduced to replace Objective-C with a safer, faster, and more developer-friendly language."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Swift is designed with <strong>performance, safety, and simplicity</strong> in mind. It eliminates many common programming errors through features like optionals, type safety, and automatic memory management."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Swift is widely used for <strong>iPhone app development</strong>, iPad apps, macOS applications, Apple Watch apps, and server-side development. Developers use Swift with <strong>Xcode</strong> and frameworks like <strong>SwiftUI</strong> and <strong>UIKit</strong>."
        }
      ]
    },

    {
      "sectionId": "history-swift",
      "title": "History of Swift Programming Language",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "Swift was created by <strong>Apple Inc.</strong> and led by <strong>Chris Lattner</strong>. It was officially announced at Apple's WWDC conference in 2014."
        },
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "2010",
              "text": " — Swift development started internally at Apple."
            },
            {
              "strong": "2014",
              "text": " — Swift 1.0 officially released at WWDC."
            },
            {
              "strong": "2015",
              "text": " — Swift became open-source."
            },
            {
              "strong": "2019",
              "text": " — SwiftUI framework introduced for declarative UI development."
            },
            {
              "strong": "2024-2026",
              "text": " — Swift improved concurrency, performance, package management, and cross-platform support."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "features-swift",
      "title": "Key Features of Swift",
      "blocks": [
        {
          "type": "featureCards",
          "items": [
            {
              "icon": "⚡",
              "title": "Fast Performance",
              "text": "Swift is highly optimized and performs much faster than Objective-C."
            },
            {
              "icon": "🔒",
              "title": "Safe Language",
              "text": "Swift prevents null pointer crashes and memory issues using optionals and type safety."
            },
            {
              "icon": "📖",
              "title": "Easy Syntax",
              "text": "Swift syntax is clean, modern, and beginner-friendly."
            },
            {
              "icon": "🧠",
              "title": "Automatic Memory Management",
              "text": "Swift uses ARC (Automatic Reference Counting) for memory management."
            },
            {
              "icon": "📱",
              "title": "Apple Ecosystem",
              "text": "Swift is the primary language for iOS, macOS, watchOS, and tvOS development."
            },
            {
              "icon": "🌐",
              "title": "Open Source",
              "text": "Swift is open-source and supports Linux and server-side development."
            }
          ]
        }
      ]
    },

