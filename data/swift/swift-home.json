    {
      "sectionId": "swiftui",
      "title": "SwiftUI Framework",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>SwiftUI</strong> is Apple's modern declarative UI framework introduced in 2019. It simplifies iOS app development using a clean and reactive syntax."
        },
        {
          "type": "codeBox",
          "lang": "🍎 SwiftUI",
          "label": "ContentView.swift",
          "lines": [
            "import SwiftUI",
            "",
            "struct ContentView: View {",
            "    var body: some View {",
            "        Text(\"Hello SwiftUI\")",
            "    }",
            "}"
          ]
        }
      ]
    },

