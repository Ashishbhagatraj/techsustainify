      "blocks": [
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "📦 Classes",
              "text": " — Used to create objects and blueprints."
            },
            {
              "strong": "🧬 Inheritance",
              "text": " — One class can inherit properties from another class."
            },
            {
              "strong": "🔒 Encapsulation",
              "text": " — Protects data using access control."
            },
            {
              "strong": "🎭 Polymorphism",
              "text": " — Methods behave differently in different classes."
            }
          ]
        }
      ]
