    {
      "sectionId": "advantages-disadvantages",
      "title": "Advantages and Disadvantages of MongoDB",
      "blocks": [
        {
          "type": "prosConsTable",
          "pros": [
            {
              "title": "Flexible Schema",
              "text": "No fixed schema required."
            },
            {
              "title": "High Scalability",
              "text": "Supports horizontal scaling with sharding."
            },
            {
              "title": "Fast Development",
              "text": "Easy integration with JavaScript-based applications."
            }
          ],
          "cons": [
            {
              "title": "High Memory Usage",
              "text": "Indexes can consume significant memory."
            },
            {
              "title": "Complex Transactions",
              "text": "Relational databases handle complex joins better."
            },
            {
              "title": "Data Duplication",
              "text": "Document structure may lead to duplicate data."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-interview",
      "title": "MongoDB Interview Questions",
      "blocks": [
        {
          "type": "interviewQA",
          "items": [
            {
              "q": "Q1. What is MongoDB?",
              "a": "MongoDB is a NoSQL document-oriented database that stores data in BSON documents.",
              "tag": "Must Know"
            },
            {
              "q": "Q2. What is a collection in MongoDB?",
              "a": "A collection is a group of MongoDB documents similar to a table in SQL.",
              "tag": "Frequently Asked"
            },
            {
              "q": "Q3. What is sharding?",
              "a": "Sharding distributes data across multiple servers for scalability.",
              "tag": "Important"
            },
            {
              "q": "Q4. What is MongoDB Atlas?",
              "a": "MongoDB Atlas is a managed cloud database service for MongoDB.",
              "tag": "Must Know"
            }
          ]
        }
      ]
    },

