    {
      "sectionId": "mongodb-documents",
      "title": "MongoDB Documents and Collections",
      "blocks": [
        {
          "type": "paragraph",
          "text": "MongoDB stores data in documents inside collections."
        },
        {
          "type": "codeBox",
          "lang": "🍃 JSON",
          "label": "student-document.json",
          "lines": [
            "{",
            "  \"name\": \"Ashish\",",
            "  \"age\": 22,",
            "  \"course\": \"BCA\"",
            "}"
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-installation",
      "title": "MongoDB Installation",
      "blocks": [
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "Step 1",
              "text": " — Download MongoDB Community Server."
            },
            {
              "strong": "Step 2",
              "text": " — Install MongoDB Compass GUI."
            },
            {
              "strong": "Step 3",
              "text": " — Start MongoDB server using mongod command."
            },
            {
              "strong": "Step 4",
              "text": " — Connect using Mongo Shell or Compass."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-crud",
      "title": "MongoDB CRUD Operations",
      "blocks": [
        {
          "type": "subHeading",
          "text": "Insert Document"
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "insert.js",
          "lines": [
            "db.students.insertOne({",
            "  name: \"Ashish\",",
            "  age: 22",
            "})"
          ]
        },

        {
          "type": "subHeading",
          "text": "Find Document"
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "find.js",
          "lines": [
            "db.students.find()"
          ]
        },

        {
          "type": "subHeading",
          "text": "Update Document"
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "update.js",
          "lines": [
            "db.students.updateOne(",
            "  { name: \"Ashish\" },",
            "  { $set: { age: 23 } }",
            ")"
          ]
        },

        {
          "type": "subHeading",
          "text": "Delete Document"
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "delete.js",
          "lines": [
            "db.students.deleteOne({",
            "  name: \"Ashish\"",
            "})"
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-aggregation",
      "title": "MongoDB Aggregation Framework",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Aggregation is used for data processing and analysis in MongoDB."
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "aggregation.js",
          "lines": [
            "db.orders.aggregate([",
            "  { $group: {",
            "      _id: \"$category\",",
            "      total: { $sum: \"$price\" }",
            "  }}",
            "])"
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-indexing",
      "title": "MongoDB Indexing",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Indexes improve query performance in MongoDB."
        },
        {
          "type": "codeBox",
          "lang": "🍃 MongoDB",
          "label": "index.js",
          "lines": [
            "db.students.createIndex({",
            "  name: 1",
            "})"
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-replication",
      "title": "MongoDB Replication",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Replication creates multiple copies of data for high availability."
        },
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "Primary Node",
              "text": " — Handles write operations."
            },
            {
              "strong": "Secondary Nodes",
              "text": " — Replicate data from primary."
            },
            {
              "strong": "Automatic Failover",
              "text": " — Another node becomes primary if current primary fails."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-sharding",
      "title": "MongoDB Sharding",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Sharding distributes data across multiple servers for horizontal scaling."
        },
        {
          "type": "featureCards",
          "items": [
            {
              "icon": "📦",
              "title": "Shard",
              "text": "Stores part of the data."
            },
            {
              "icon": "🧭",
              "title": "Config Server",
              "text": "Stores cluster metadata."
            },
            {
              "icon": "🔀",
              "title": "Query Router",
              "text": "Routes client requests to correct shard."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "mongodb-atlas",
      "title": "What is MongoDB Atlas?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>MongoDB Atlas</strong> is MongoDB's fully managed cloud database service. It allows developers to deploy MongoDB clusters on AWS, Azure, and Google Cloud."
        },
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "Cloud Hosting",
              "text": " — Deploy MongoDB in the cloud."
            },
            {
              "strong": "Automatic Backups",
              "text": " — Atlas automatically backs up data."
            },
            {
              "strong": "Security",
              "text": " — Includes encryption and authentication."
            }
          ]
        }
      ]
    },

