  "sections": [

    {
      "sectionId": "what-is-mongodb",
      "title": "What is MongoDB?",
      "blocks": [
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "<strong>MongoDB is a NoSQL, document-oriented database</strong> designed for modern applications. Instead of storing data in tables and rows like traditional relational databases, MongoDB stores data in flexible <strong>JSON-like BSON documents</strong>."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "MongoDB was developed by <strong>MongoDB Inc.</strong> and first released in <strong>2009</strong>. It is highly scalable, flexible, and widely used in modern web applications, cloud systems, mobile apps, and real-time applications."
        },
        {
          "type": "paragraph",
          "isHtml": true,
          "text": "MongoDB is one of the most popular <strong>NoSQL databases</strong> in the world and is commonly used with the <strong>MERN stack</strong> (MongoDB, Express.js, React.js, Node.js)."
        }
      ]
    },

    {
      "sectionId": "history-mongodb",
      "title": "History of MongoDB",
      "blocks": [
        {
          "type": "bulletList",
          "items": [
            {
              "strong": "2007",
              "text": " — MongoDB development started by 10gen company."
            },
            {
              "strong": "2009",
              "text": " — MongoDB officially released as an open-source NoSQL database."
            },
            {
              "strong": "2013",
              "text": " — 10gen renamed to MongoDB Inc."
            },
            {
              "strong": "2016",
              "text": " — MongoDB Atlas cloud platform launched."
            },
            {
              "strong": "2020+",
              "text": " — MongoDB became one of the most widely used NoSQL databases globally."
            }
          ]
        }
      ]
    },

    {
      "sectionId": "features-mongodb",
      "title": "Key Features of MongoDB",
      "blocks": [
        {
          "type": "featureCards",
          "items": [
            {
              "icon": "📄",
              "title": "Document Database",
              "text": "Stores data as flexible BSON documents instead of rows and columns."
            },
            {
              "icon": "⚡",
              "title": "High Performance",
              "text": "MongoDB provides fast read and write operations."
            },
            {
              "icon": "🌐",
              "title": "Scalable",
              "text": "Supports horizontal scaling using sharding."
            },
            {
              "icon": "☁️",
              "title": "Cloud Ready",
              "text": "MongoDB Atlas provides managed cloud database services."
            },
            {
              "icon": "🔍",
              "title": "Powerful Query Language",
              "text": "Supports rich queries, aggregation, indexing, and filtering."
            },
            {
              "icon": "🔄",
              "title": "Replication",
              "text": "Provides high availability using replica sets."
            }
          ]
        }
      ]
    },

